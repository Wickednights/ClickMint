# =============================================================================
# ClickMint — contracts / Hardhat (copy to `contracts/.env`)
# =============================================================================
# Used by: `hardhat.config.ts`, `scripts/deploy.ts`, `set-game.ts`, etc.
# dotenv loads `../.env` then `./.env` (override). You can keep secrets only here.
# =============================================================================

# --- Base Sepolia (84532) — deploy, scripts with --network baseSepolia
QUICKNODE_RPC="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# Optional second name (hardhat uses QUICKNODE_RPC first, then this).
# BASE_SEPOLIA_RPC_URL="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# --- Base mainnet (8453) — deploy, scripts with --network base
BASE_MAINNET_RPC_URL="https://YOUR-ENDPOINT.base-mainnet.quiknode.pro/YOUR_SECRET/"
# Optional alias (hardhat tries BASE_MAINNET_RPC_URL first, then this):
# QUICKNODE_BASE_RPC="https://YOUR-ENDPOINT.base-mainnet.quiknode.pro/YOUR_SECRET/"

# 64 hex chars, optional 0x. One line. Never commit real keys; never put on Vercel.
DEPLOYER_KEY="0xYOUR_64_HEX_PRIVATE_KEY"

# --- `scripts/deploy.ts` ------------------------------------------------------
# testnet | mainnet (default testnet if unset). See `scripts/config/economy.ts`.
# Sepolia: usually DEPLOY_ECONOMY=testnet. Mainnet: DEPLOY_ECONOMY=mainnet.
DEPLOY_ECONOMY="testnet"

# --- `scripts/set-game.ts` / `verify-deployment.ts` -------------------------
# CLICK_ADDRESS="0x..."
# GAME_ADDRESS="0x..."
# TROPHY_ADDRESS="0x..."

# --- `scripts/verify-deployment.ts` only --------------------------------------
# Omit to skip cap check. Testnet 1M tokens: 1000000000000000000000000
# Mainnet-style 100B: 100000000000000000000000000000
# EXPECTED_MAX_SUPPLY_WEI="1000000000000000000000000"

# --- `scripts/set-economy-round.ts` -------------------------------------------
# GAME_ADDRESS="0x..."
# ECONOMY="testnet"
# Optional raw wei overrides:
# CLICK_PER_ETH_WEI=""
# CLICK_COST_CREDITS=""
# BASE_CLICK_REWARD=""

# --- `scripts/set-pot-keeper.ts` (owner) --------------------------------------
# GAME_ADDRESS="0x..."
# POT_KEEPER_ADDRESS="0x..."
# Run with: npx hardhat run scripts/set-pot-keeper.ts --network baseSepolia
#           npx hardhat run scripts/set-pot-keeper.ts --network base
