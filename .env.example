# =============================================================================
# ClickMint — root `.env.example` (monorepo quick reference)
# Canonical tables: docs/ENVIRONMENT_VARIABLES.md
# =============================================================================
# Copy values into:
#   • `contracts/.env`     — Hardhat deploy & scripts (needs DEPLOYER_KEY + RPC)
#   • `frontend/.env.local` or `frontend/.env` — Next.js (only NEXT_PUBLIC_* required for UI)
#
# Vercel: add every `NEXT_PUBLIC_*` variable below to each environment (Production,
# Preview, Development) with the addresses/RPC that match that deployment. Never put
# `DEPLOYER_KEY` on Vercel — it is local / CI only.
#
# Two chains: Base Sepolia (84532) = cheap smoke + tCLICK; Base mainnet (8453) = real QA.
# Prefer separate Vercel projects (or env groups) so cron secrets / keeper keys for 8453
# never run against 84532 addresses (or vice versa).
#
# Auto on Vercel (do not set manually): VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, NODE_ENV
# =============================================================================

# --- Target chain (frontend) -------------------------------------------------
# Omit or 84532 = Base Sepolia (default in repo). 8453 = Base mainnet QA / production.
# NEXT_PUBLIC_CHAIN_ID="84532"

# --- RPC: Base Sepolia -------------------------------------------------------
# Server-side / Hardhat (`contracts/hardhat.config.ts` uses QUICKNODE_RPC first).
QUICKNODE_RPC="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# Optional alias if you prefer this name (Hardhat accepts either).
# BASE_SEPOLIA_RPC_URL="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# Browser / Next.js wagmi (Sepolia). Can match QUICKNODE_RPC.
NEXT_PUBLIC_QUICKNODE_RPC="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# --- RPC: Base mainnet (8453) ------------------------------------------------
# Hardhat `base` network: BASE_MAINNET_RPC_URL or QUICKNODE_BASE_RPC (see hardhat.config.ts).
# BASE_MAINNET_RPC_URL="https://YOUR-ENDPOINT.base-mainnet.quiknode.pro/YOUR_SECRET/"
# QUICKNODE_BASE_RPC="https://YOUR-ENDPOINT.base-mainnet.quiknode.pro/YOUR_SECRET/"

# Frontend wagmi + cron fallback when NEXT_PUBLIC_CHAIN_ID=8453:
# NEXT_PUBLIC_BASE_MAINNET_RPC="https://YOUR-ENDPOINT.base-mainnet.quiknode.pro/YOUR_SECRET/"

# --- Deployer (Hardhat only — NEVER commit real key; NEVER add to Vercel) -----
# 64 hex characters, optional single 0x prefix. One line, ASCII, no smart quotes.
DEPLOYER_KEY="0xYOUR_64_HEX_PRIVATE_KEY"

# --- Deploy preset (Hardhat `scripts/deploy.ts`) -----------------------------
# testnet (default) = 1M tCLICK cap, 10 trophies, 10m vesting, ultra-cheap credits.
# mainnet = 100B cap, 10k trophies, 7d vesting, ~1¢/click at MAINNET_ETH_USD.
DEPLOY_ECONOMY="testnet"

# --- Next.js / Vercel (all optional at build time if you rely on `lib/addresses.ts` fallbacks on Sepolia only) --
# Public site URL for Open Graph / metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# testnet | mainnet — must match `DEPLOY_ECONOMY` used when contracts were deployed (header UI hint only).
NEXT_PUBLIC_DEPLOY_ECONOMY="testnet"

# WalletConnect (optional). https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Pimlico — gasless clicks (optional). Policy must allow the same chain as NEXT_PUBLIC_CHAIN_ID (84532 and/or 8453).
NEXT_PUBLIC_PIMLICO_API_KEY=""

# --- Contract addresses (Base Sepolia, 84532) — replace after each redeploy ------------
# Active testnet set — see docs/DEPLOYMENT_ADDRESSES.md
NEXT_PUBLIC_CLICK_ADDRESS="0xeB4928cf96D10F47d76d5997Ef1179c242C95Dc1"
NEXT_PUBLIC_GAME_ADDRESS="0x1EFf9a6c3F3C438a2929301d1AEeD9D048f04D6B"
# NEXT_PUBLIC_CLICKMINT_GAME_ADDRESS="0x1EFf9a6c3F3C438a2929301d1AEeD9D048f04D6B"

NEXT_PUBLIC_TREASURY_ADDRESS="0x9869d1e0e4416b7e3B246D9C444a6355cA19344c"
NEXT_PUBLIC_SECRET_WALLET_ADDRESS="0xeCB7132cc27e177f7028475f58Ee8b3D43F074E2"
NEXT_PUBLIC_TROPHY_NFT_ADDRESS="0xd190828F946659a1ff338AD6bC6BAF7C59f9eefD"
NEXT_PUBLIC_ESCROW_ADDRESS="0x3F71C068aaC3359332E5c464E91F0c8b23dF590a"

# --- Base mainnet (8453): set ALL of the above addresses when NEXT_PUBLIC_CHAIN_ID=8453 ---
# (No in-repo defaults for mainnet — use addresses from your deploy / docs/DEPLOYMENT_ADDRESSES.md.)

# --- Cron / pot keeper (frontend server only — never expose POT_KEEPER_PRIVATE_KEY to client) ---
# CRON_SECRET=""
# POT_KEEPER_PRIVATE_KEY=""
# POT_KEEPER_RPC_URL=""
