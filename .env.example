# =============================================================================
# ClickMint — root `.env.example` (monorepo quick reference)
# =============================================================================
# Copy values into:
#   • `contracts/.env`     — Hardhat deploy & scripts (needs DEPLOYER_KEY + RPC)
#   • `frontend/.env.local` or `frontend/.env` — Next.js (only NEXT_PUBLIC_* required for UI)
#
# Vercel: add every `NEXT_PUBLIC_*` variable below to each environment (Production,
# Preview, Development) with the addresses/RPC that match that deployment. Never put
# `DEPLOYER_KEY` on Vercel — it is local / CI only.
#
# Auto on Vercel (do not set manually): VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, NODE_ENV
# =============================================================================

# --- RPC (Base Sepolia) ------------------------------------------------------
# Server-side / Hardhat (`contracts/hardhat.config.ts` uses QUICKNODE_RPC first).
QUICKNODE_RPC="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# Optional alias if you prefer this name (Hardhat accepts either).
# BASE_SEPOLIA_RPC_URL="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# Browser / Next.js (`frontend/lib/wagmi.ts`, Pimlico bundler URL). Can match QUICKNODE_RPC.
NEXT_PUBLIC_QUICKNODE_RPC="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# --- Deployer (Hardhat only — NEVER commit real key; NEVER add to Vercel) -----
# 64 hex characters, optional single 0x prefix. One line, ASCII, no smart quotes.
DEPLOYER_KEY="0xYOUR_64_HEX_PRIVATE_KEY"

# --- Deploy preset (Hardhat `scripts/deploy.ts`) -----------------------------
# testnet (default) = 1M CLICK cap, 10 trophies, 10m vesting, readable click cost.
# mainnet = 100B cap, 10k trophies, 7d vesting, ~1¢/click at MAINNET_ETH_USD.
DEPLOY_ECONOMY="testnet"

# --- Next.js / Vercel (all optional at build time if you rely on `lib/addresses.ts` fallbacks) --
# Public site URL for Open Graph / metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# testnet | mainnet — must match `DEPLOY_ECONOMY` used when contracts were deployed (header UI hint only).
NEXT_PUBLIC_DEPLOY_ECONOMY="testnet"

# WalletConnect (optional). https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Pimlico — gasless clicks (optional). https://dashboard.pimlico.io — client-visible; restrict in dashboard.
NEXT_PUBLIC_PIMLICO_API_KEY=""

# --- Contract addresses (Base Sepolia) — replace after each redeploy ------------
# Example: 2026-04-07 TESTNET_PRESET deploy (1M CLICK, 10 trophies, 10m vesting).
NEXT_PUBLIC_CLICK_ADDRESS="0x6CB127e069D98F6A0B1851585670495DA93cB5D5"
NEXT_PUBLIC_GAME_ADDRESS="0xEA612843365Cc1B53f9FC6988d6edD54aeD84013"
# Optional alias (same as NEXT_PUBLIC_GAME_ADDRESS if set).
# NEXT_PUBLIC_CLICKMINT_GAME_ADDRESS="0xEA612843365Cc1B53f9FC6988d6edD54aeD84013"

NEXT_PUBLIC_TREASURY_ADDRESS="0x3B04A33D89F114185FF7194a1f8b13b086999471"
NEXT_PUBLIC_SECRET_WALLET_ADDRESS="0xB4BD710d5691Dbb7BF02791ddAd9f818F4a47Af5"
NEXT_PUBLIC_TROPHY_NFT_ADDRESS="0xE367E485fF1C2946d4435bab6649C576Ca526476"
NEXT_PUBLIC_ESCROW_ADDRESS="0x2457623b777DE271CDC9d9D37E3a93f19fcc5960"
