# =============================================================================
# ClickMint — frontend / Next.js (copy to `frontend/.env.local` or `frontend/.env`)
# =============================================================================
# Build: Next.js inlines `NEXT_PUBLIC_*` at build time — change Vercel env → redeploy.
#
# Vercel checklist (set per environment: Production / Preview / Development):
#   [ ] NEXT_PUBLIC_QUICKNODE_RPC
#   [ ] NEXT_PUBLIC_SITE_URL (public URL, no trailing slash — e.g. https://clickmint.app or https://preview.clickmint.app)
#   [ ] NEXT_PUBLIC_DEPLOY_ECONOMY (testnet | mainnet — match contract deploy)
#   [ ] NEXT_PUBLIC_CLICK_ADDRESS
#   [ ] NEXT_PUBLIC_GAME_ADDRESS
#   [ ] NEXT_PUBLIC_TREASURY_ADDRESS
#   [ ] NEXT_PUBLIC_SECRET_WALLET_ADDRESS
#   [ ] NEXT_PUBLIC_TROPHY_NFT_ADDRESS
#   [ ] NEXT_PUBLIC_ESCROW_ADDRESS
#   [ ] NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID (optional)
#   [ ] NEXT_PUBLIC_PIMLICO_API_KEY (optional — gasless clicks)
#   [ ] NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID (optional — if your Pimlico policy requires it)
#
# Do NOT set on Vercel: DEPLOYER_KEY, private RPC secrets (use HTTPS endpoint with
# path secret if your provider allows; still public to anyone who inspects network).
#
# Injected automatically on Vercel (no action): VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, NODE_ENV
#
# --- Pot keeper cron (optional) — finalizeHour automation ------------------------------
# Vercel: set CRON_SECRET in Project → Environment Variables; Vercel Cron sends
# Authorization: Bearer <CRON_SECRET> when invoking /api/cron/finalize-hour.
# See frontend/vercel.json (crons) and docs/LP_AERODROME_AND_AUTOMATION.md.
# CRON_SECRET=""
# POT_KEEPER_PRIVATE_KEY=""
# Optional dedicated RPC for the keeper (defaults to NEXT_PUBLIC_QUICKNODE_RPC).
# POT_KEEPER_RPC_URL=""
# =============================================================================

# Public site URL for Open Graph, WalletConnect metadata (SSR), metadataBase (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://clickmint.app"

# Base Sepolia JSON-RPC (wagmi + Pimlico). Falls back to https://sepolia.base.org if unset.
NEXT_PUBLIC_QUICKNODE_RPC="https://YOUR-ENDPOINT.base-sepolia.quiknode.pro/YOUR_SECRET/"

# testnet | mainnet — should match `DEPLOY_ECONOMY` when contracts were deployed.
# Economy labels treat unset as testnet; the /debug owner mint UI requires this to be explicitly `testnet`.
NEXT_PUBLIC_DEPLOY_ECONOMY="testnet"

# WalletConnect — optional; enables QR / mobile wallets. https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Pimlico — optional; gasless clicks (ERC-4337). https://dashboard.pimlico.io
# Enable chain Base Sepolia (84532), create a Verifying paymaster + sponsorship policy if prompted.
NEXT_PUBLIC_PIMLICO_API_KEY=""
# If `pm_getPaymasterData` errors on missing policy, paste the policy id from the Pimlico dashboard.
NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID=""

# --- Contract addresses (Base Sepolia, chain id 84532) ------------------------
# Replace after redeploy. Example below: TESTNET_PRESET (1M CLICK, 10 trophies, 10m vesting).
NEXT_PUBLIC_CLICK_ADDRESS="0xeB4928cf96D10F47d76d5997Ef1179c242C95Dc1"
NEXT_PUBLIC_GAME_ADDRESS="0x1EFf9a6c3F3C438a2929301d1AEeD9D048f04D6B"

# Optional alias — same value as NEXT_PUBLIC_GAME_ADDRESS if your tooling expects it.
# NEXT_PUBLIC_CLICKMINT_GAME_ADDRESS="0x1EFf9a6c3F3C438a2929301d1AEeD9D048f04D6B"

# Optional — show “round N since launch” instead of raw on-chain hour index (~493k).
# Use the game contract deployment time (Unix seconds) from Basescan, OR set block below.
# NEXT_PUBLIC_GAME_GENESIS_UNIX="1730000000"
# Optional — overrides genesis unix if set: contract creation block number (fetches timestamp once).
# NEXT_PUBLIC_GAME_DEPLOY_BLOCK="12345678"

NEXT_PUBLIC_TREASURY_ADDRESS="0x9869d1e0e4416b7e3B246D9C444a6355cA19344c"
NEXT_PUBLIC_SECRET_WALLET_ADDRESS="0xeCB7132cc27e177f7028475f58Ee8b3D43F074E2"
NEXT_PUBLIC_TROPHY_NFT_ADDRESS="0xd190828F946659a1ff338AD6bC6BAF7C59f9eefD"
NEXT_PUBLIC_ESCROW_ADDRESS="0x3F71C068aaC3359332E5c464E91F0c8b23dF590a"
